generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PARTNER_OWNER
  PARTNER_ADMIN
  PARTNER_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DISABLED
}

enum VisitorType {
  CITIZEN
  RESIDENT
  VISITOR
}

enum InterestCode {
  HERITAGE
  ADVENTURE
  FOOD
  EVENTS
  SHOPPING
  GUIDES
  STAYS
  NATURE
  FAMILY
  SPORTS
  TECHNOLOGY
  SEASONAL
}

enum PartnerType {
  INDIVIDUAL
  BUSINESS
  GOVERNMENT_NONPROFIT
}

enum PartnerApplicantRole {
  OWNER
  REPRESENTATIVE
}

enum PartnerStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_COMPLETION
  PRE_APPROVED
  WAITING_AGREEMENT
  AGREEMENT_ACCEPTED
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PartnerChangeRequestStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
  CANCELLED
}

enum PartnerDocumentType {
  IDENTITY
  BUSINESS_PROOF
  COMMERCIAL_REGISTER
  AUTHORIZATION
  VAT_CERTIFICATE
  IBAN_CERTIFICATE
  GOVERNMENT_LETTER
  OTHER
}

enum PartnerDocumentStatus {
  PENDING
  AI_REVIEWED
  NEEDS_CORRECTION
  VERIFIED
  REJECTED
}

enum LicenseStatus {
  PENDING
  VERIFIED
  EXPIRED
  SUSPENDED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  SUSPENDED
  REJECTED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum LoyaltyScope {
  ALL
  CATEGORY
  SERVICE
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  GIFT_SENT
  GIFT_RECEIVED
  ADJUSTMENT
}

enum BookingStatus {
  PENDING
  PAID
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgreementStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  TERMINATED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PARTNER_CONTACT_PHONE_VERIFICATION
  PASSWORD_RESET
  ADMIN_INVITATION
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  username     String?      @unique
  phone        String?      @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role             UserRole     @default(CUSTOMER)
  status           UserStatus   @default(PENDING_VERIFICATION)
  adminPermissions Json?
  profileImageUrl  String?
  visitorType  VisitorType?

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnerMemberships PartnerMember[]
  sentPartnerInvitations PartnerInvitation[] @relation("PartnerInvitationInviter")
  bookings           Booking[]
  couponRedemptions  CouponRedemption[]
  loyaltyWallet      LoyaltyWallet?
  loyaltyTransactions LoyaltyTransaction[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  partnerContactVerification PartnerContactVerification?
  interests          UserInterest[]
  favoriteServices   UserFavoriteService[]
  interestNotificationReads InterestNotificationRead[]
  auditLogs          AuditLog[]          @relation("AuditUser")
}

model UserInterest {
  id String @id @default(cuid())

  userId String
  code   InterestCode

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@index([code])
}

model Session {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id String @id @default(cuid())

  userId String

  type VerificationTokenType

  tokenHash String @unique

  target String?

  expiresAt  DateTime
  consumedAt DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@index([consumedAt])
}

model PartnerContactVerification {
  id String @id @default(cuid())

  userId String @unique
  phone  String

  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
}

model Partner {
  id String @id @default(cuid())

  partnerType   PartnerType?
  applicantRole PartnerApplicantRole?

  legalNameAr String
  legalNameEn String?
  tradeNameAr String?
  tradeNameEn String?

  unifiedNumber      String? @unique
  commercialRegister String? @unique
  proofType          String?
  descriptionAr      String?

  vatRegistered Boolean @default(false)
  vatNumber     String?

  logoUrl    String?
  websiteUrl String?

  country          String?
  city             String?
  address          String?
  locationName     String?
  formattedAddress String?
  placeId          String?
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)

  businessPhone String?
  businessEmail String?

  applicantJobTitle String?

  financeContactName  String?
  financeContactEmail String?
  financeContactPhone String?

  mainContactName            String?
  mainContactEmail           String?
  mainContactPhone           String?
  mainContactPhoneVerifiedAt DateTime?
  mainContactJobTitle        String?

  operates24h    Boolean @default(false)
  operatingHours String?

  receivesPayments Boolean @default(false)
  iban             String?
  bankName         String?
  swiftCode        String?
  beneficiaryName  String?

  publicName String?

  commissionRate Decimal? @db.Decimal(5, 2)
  transferFee    Decimal  @default(1.00) @db.Decimal(10, 2)

  status PartnerStatus @default(DRAFT)

  submittedAt   DateTime?
  reviewedAt    DateTime?
  preApprovedAt DateTime?
  approvedAt    DateTime?
  activatedAt   DateTime?
  suspendedAt   DateTime?
  rejectedAt    DateTime?

  reviewNotes     String?
  completionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   PartnerDocument[]
  members     PartnerMember[]
  invitations PartnerInvitation[]
  licenses    License[]
  categories  PartnerCategory[]
  services    Service[]
  bookings    Booking[]
  invoices    Invoice[]
  settlements Settlement[]
  agreements  Agreement[]
  changeRequests PartnerChangeRequest[]
  loyaltySettings PartnerLoyaltySetting[]

  @@index([status])
  @@index([partnerType])
  @@index([city])
}

model PartnerChangeRequest {
  id String @id @default(cuid())

  partnerId String
  requestedByUserId String?

  changes Json
  reason  String?

  status PartnerChangeRequestStatus @default(PENDING)
  adminNotes String?

  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([submittedAt])
}

model PartnerCategory {
  id String @id @default(cuid())

  partnerId String
  name      String

  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, name])
  @@index([partnerId])
}

model PartnerMember {
  id String @id @default(cuid())

  partnerId String
  userId    String

  jobTitle    String?
  permissions Json?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@index([userId])
}

model PartnerInvitation {
  id String @id @default(cuid())
  partnerId String
  invitedByUserId String
  email String
  tokenHash String @unique
  role String
  jobTitle String?
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  invitedBy User @relation("PartnerInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([partnerId, email])
  @@index([expiresAt])
}

model PartnerDocument {
  id String @id @default(cuid())

  partnerId String

  type           PartnerDocumentType
  label          String?
  fileUrl        String
  fileName       String?
  mimeType       String?
  documentNumber String?
  issuer         String?
  issueDate      DateTime?
  expiryDate     DateTime?

  status      PartnerDocumentStatus  @default(PENDING)
  aiStatus    PartnerDocumentStatus?
  aiNotes     String?
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([type])
  @@index([status])
}

model License {
  id String @id @default(cuid())

  partnerId String

  type          String
  issuer        String
  licenseNumber String
  issueDate     DateTime?
  expiryDate    DateTime?
  documentUrl   String?

  status LicenseStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  services Service[]

  @@unique([partnerId, licenseNumber])
  @@index([partnerId])
}

model Service {
  id String @id @default(cuid())

  partnerId String
  licenseId String?

  nameAr String
  nameEn String?

  category    String
  subCategory String?

  descriptionAr String?
  descriptionEn String?

  city             String?
  region           String?
  locationName     String?
  formattedAddress String?
  placeId          String?
  country           String?
  countryCode       String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  basePrice  Decimal @db.Decimal(12, 2)
  vatRate    Decimal @default(15.00) @db.Decimal(5, 2)
  finalPrice Decimal @db.Decimal(12, 2)
  loyaltyPoints Int @default(150)

  capacity            Int?
  cancellationPolicy  String?
  meetingInstructions String?
  meetingPointName     String?
  meetingPointAddress  String?
  meetingLatitude      Decimal? @db.Decimal(10, 7)
  meetingLongitude     Decimal? @db.Decimal(10, 7)

  organizerType          String? @default("SELF")
  organizerName          String?
  organizerLicenseNumber String?
  organizerLicenseIssuer String?
  programApprovalNumber  String?

  status ServiceStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  license License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  favorites UserFavoriteService[]
  interestNotificationReads InterestNotificationRead[]
  images   ServiceImage[]
  bookings Booking[]
  coupons  Coupon[]
  loyaltySettings PartnerLoyaltySetting[]

  @@index([partnerId])
  @@index([status])
  @@index([category])
}

model ServiceImage {
  id        String @id @default(cuid())
  serviceId String
  url       String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}


model LoyaltyWallet {
  id        String @id @default(cuid())
  userId    String @unique
  balance   Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
}

model LoyaltyTransaction {
  id          String @id @default(cuid())
  userId      String
  type        LoyaltyTransactionType
  points      Int
  description String?
  referenceId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@index([referenceId])
}

model PartnerLoyaltySetting {
  id String @id @default(cuid())

  partnerId String
  scope LoyaltyScope
  category String?
  serviceId String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([partnerId, isActive])
  @@index([serviceId])
  @@index([category])
}

model Coupon {
  id String @id @default(cuid())

  code String @unique
  name String?

  discountType CouponDiscountType
  discountValue Decimal @db.Decimal(12, 2)

  startsAt DateTime?
  expiresAt DateTime?

  isActive Boolean @default(true)
  maxUses Int?
  usedCount Int @default(0)
  maxUsesPerUser Int?

  minOrderAmount Decimal? @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2)

  serviceId String?
  category String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@index([code])
  @@index([serviceId])
  @@index([category])
  @@index([isActive])
  @@index([expiresAt])
}

model CouponRedemption {
  id String @id @default(cuid())

  couponId String
  bookingId String @unique
  userId String?

  codeSnapshot String
  discountAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
}

model Booking {
  id String @id @default(cuid())

  reference String @unique

  userId    String?
  partnerId String
  serviceId String

  customerName  String
  customerEmail String?
  customerPhone String?

  guests Int @default(1)

  baseAmount  Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  paymentReference String?
  paymentMethod    String?

  status BookingStatus @default(PENDING)

  bookingDate DateTime  @default(now())
  serviceDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  invoice Invoice?
  couponRedemption CouponRedemption?

  @@index([userId])
  @@index([partnerId])
  @@index([serviceId])
  @@index([status])
}

model Invoice {
  id String @id @default(cuid())

  invoiceNumber String @unique
  bookingId     String @unique
  partnerId     String

  subtotal    Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  qrData String?
  pdfUrl String?

  issuedAt DateTime?
  paidAt   DateTime?

  status InvoiceStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@index([status])
}

model Settlement {
  id String @id @default(cuid())

  settlementNumber String @unique
  partnerId        String

  periodStart DateTime
  periodEnd   DateTime

  grossSales         Decimal @db.Decimal(12, 2)
  platformCommission Decimal @db.Decimal(12, 2)
  paymentFees        Decimal @db.Decimal(12, 2)
  transferFees       Decimal @db.Decimal(12, 2)
  refunds            Decimal @default(0) @db.Decimal(12, 2)
  adjustments        Decimal @default(0) @db.Decimal(12, 2)
  netAmount          Decimal @db.Decimal(12, 2)

  scheduledAt DateTime?
  completedAt DateTime?

  status SettlementStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@index([status])
}

model Agreement {
  id String @id @default(cuid())

  partnerId String

  version        String
  commissionRate Decimal? @db.Decimal(5, 2)

  termsSnapshot     Json
  acceptedByName    String?
  acceptedByEmail   String?
  acceptedIp        String?
  acceptedUserAgent String?

  sentAt     DateTime?
  acceptedAt DateTime?

  status AgreementStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action     String
  entityType String
  entityId   String?

  beforeData Json?
  afterData  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Public header navigation switches controlled by platform administration.
model NavigationVisibility {
  key String @id
  visible Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model UserFavoriteService {
  id String @id @default(cuid())
  userId String
  serviceId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([userId, serviceId])
  @@index([serviceId])
}

model InterestNotificationRead {
  id String @id @default(cuid())
  userId String
  serviceId String
  readAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([userId, serviceId])
  @@index([serviceId])
}

model GuideApplication {
 id String @id @default(cuid())
 userId String
 fullName String
 email String
 phone String
 gender String
 countries String[]
 city String
 licenseCategory String
 licenseNumber String
 licenseExpiresAt DateTime
 specialization String?
 languages String[]
 bio String?
 photoPath String?
 licensePath String
 photoPublicationConsent Boolean @default(false)
 policyAcceptedAt DateTime
 status String @default("UNDER_REVIEW")
 reviewedAt DateTime?
 reviewNotes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId])
 @@index([status])
}

model LicenseRenewalRequest {
 id String @id @default(cuid())
 licenseId String
 partnerId String
 submittedById String
 requestedExpiryDate DateTime
 documentPath String
 status String @default("UNDER_REVIEW")
 reviewedById String?
 reviewedAt DateTime?
 reviewNotes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([licenseId,status])
 @@index([partnerId,status])
}

model LicenseAlert {
 id String @id @default(cuid())
 recipientUserId String
 licenseId String
 partnerId String
 kind String
 title String
 message String
 dayKey String
 readAt DateTime?
 createdAt DateTime @default(now())
 @@unique([recipientUserId,licenseId,kind,dayKey])
 @@index([recipientUserId,readAt,createdAt])
 @@index([partnerId,createdAt])
}

model GuideLicenseAlert {
 id String @id @default(cuid())
 recipientUserId String
 applicationId String
 kind String
 title String
 message String
 dayKey String
 readAt DateTime?
 createdAt DateTime @default(now())
 @@unique([recipientUserId,applicationId,kind,dayKey])
 @@index([recipientUserId,readAt,createdAt])
}

model GuideLicenseRenewal {
 id String @id @default(cuid())
 applicationId String
 userId String
 licenseNumber String
 requestedExpiryDate DateTime
 documentPath String
 status String @default("UNDER_REVIEW")
 reviewedById String?
 reviewedAt DateTime?
 reviewNotes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([applicationId,status])
 @@index([userId,createdAt])
}
