# ==========================================
# AREES LOOP — Git Ignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production build
/build

# Local environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel local configuration
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db

# Security / private keys
*.pem

